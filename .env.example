# AUTONOMOUS DESKTOP AI ENV TEMPLATE

# Main AI
GROQ_API_KEY=put_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Sessions
SESSION_SECRET=generate_a_long_random_secret

# Needed only if local Google sign-in is enabled
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Local server
HOST=127.0.0.1
PORT=8000

# Image/video generation is disabled.
# Gemini media keys are not required for normal chat.
